  "cards": [
    {
      "dot": "cyan",
      "title": "Primary Keys & Uniqueness",
      "items": [
        "health_daily_aggregates uses dateStr as single PK for quick day-based queries",
        "partner_daily_aggregates prefixes partnerId onto dateStr for composite isolation",
        "couples enforces a unique 6-digit invite_code for active pairing workflows"
      ]
    },
    {
      "dot": "emerald",
      "title": "Foreign Key Cardinality",
      "items": [
        "couples references users (one-to-many, optionality preserved for unlinked users)",
        "coupleChallenges belongs to exactly one coupleId with zero or many historical entries",
        "health_metrics samples roll up into the parent health_daily_aggregates row"
      ]
    },
    {
      "dot": "rose",
      "title": "Data Isolation Architecture",
      "items": [
        "Raw time-series vitals (health_metrics) are isolated locally from partner views",
        "Only aggregates (health_daily_aggregates) are shared and synced remotely"
      ]
    }
  ]
