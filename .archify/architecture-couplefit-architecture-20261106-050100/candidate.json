  "cards": [
    {
      "dot": "cyan",
      "title": "Client-Side Ingestion",
      "items": [
        "Compose UI drives the glassmorphic dashboard with StateFlow streams from ViewModels",
        "HealthConnectManager reads device steps, calories, and heart rate with read-only permissions",
        "HealthDatabase (Room v4) persists daily aggregates and offline snapshots locally"
      ]
    },
    {
      "dot": "emerald",
      "title": "Privacy & Cloud Sync",
      "items": [
        "FirebaseSyncManager strips raw vitals; only sanitized daily aggregates are uploaded",
        "WorkManager (SyncWorker) flushes periodic partner updates with retry backoff",
        "Cloud Firestore synchronizes active couples and triggers mutual milestone progress"
      ]
    },
    {
      "dot": "rose",
      "title": "Pairing & Realtime Alerts",
      "items": [
        "CoupleLinkManager secures partner pairing via expiring 6-digit invite codes",
        "Firebase Cloud Messaging dispatches instant partner nudges and critical alerts",
        "Zero biometric data leaves the device unaggregated or without explicit user consent"
      ]
    }
  ]
