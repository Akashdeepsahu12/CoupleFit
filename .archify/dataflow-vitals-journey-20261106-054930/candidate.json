  "cards": [
    {
      "dot": "emerald",
      "title": "On-Device Lineage",
      "items": [
        "Sensors stream raw biometrics strictly into on-device Health Connect and Samsung Health APIs",
        "HealthConnectManager calculates daily step totals and mean heart rate in memory"
      ]
    },
    {
      "dot": "rose",
      "title": "Privacy Sanitization Wall",
      "items": [
        "FirebaseSyncManager strips individual biometric sample points and timestamp series",
        "Only aggregated numbers (total steps, daily active minutes) cross the cloud network boundary"
      ]
    },
    {
      "dot": "cyan",
      "title": "Consumer Distribution",
      "items": [
        "Dashboard UI renders immediate animated feedback directly from local Room SQLite",
        "Couple Hub and Glance App Widget subscribe to synchronized partner aggregates via Firestore"
      ]
    }
  ]
