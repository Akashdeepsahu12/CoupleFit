rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getCouple(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId));
    }

    function isCoupleMember(coupleId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/couples/$(coupleId)) &&
         (request.auth.uid in getCouple(coupleId).data.members ||
          getCouple(coupleId).data.createdBy == request.auth.uid))
      );
    }

    // 1. User Profiles
    match /users/{uid} {
      allow read: if isOwner(uid) || (isAuthenticated() && (
        resource.data.partnerId == request.auth.uid ||
        (resource.data.coupleId != null && isCoupleMember(resource.data.coupleId))
      ));
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || (
        // Allow authenticated partner to link during invite redemption or pairing
        isAuthenticated() &&
        request.resource.data.partnerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerId', 'coupleId', 'status', 'updatedAt'])
      );
      allow delete: if isOwner(uid);
    }

    // 2. Invites (Creation and Redemption fallback for client and Cloud Functions)
    match /invites/{code} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.code == code;
      allow update: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        (resource.data.status == 'PENDING' && request.resource.data.status == 'REDEEMED' && request.resource.data.redeemedBy == request.auth.uid)
      );
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // 3. Couples
    match /couples/{coupleId} {
      allow read: if isCoupleMember(coupleId) || (isAuthenticated() && resource.data.status == 'INVITING');
      allow create: if isAuthenticated() && 
        (request.auth.uid in request.resource.data.members) &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && (
        isCoupleMember(coupleId) ||
        // Allow a partner to join an open couple (strictly enforces max 2 members)
        (resource.data.members.size() < 2 && (request.auth.uid in request.resource.data.members)) ||
        (resource.data.status == 'INVITING' && request.resource.data.members.size() <= 2 && (request.auth.uid in request.resource.data.members))
      );
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;

      // 3.1 Daily Aggregates: couples/{coupleId}/daily/{uid_date}
      match /daily/{docId} {
        allow read: if isCoupleMember(coupleId) || (
          isAuthenticated() && (
            docId.matches('^' + request.auth.uid + '_.*') ||
            (resource.data.userId != null && exists(/databases/$(database)/documents/users/$(resource.data.userId)) &&
             get(/databases/$(database)/documents/users/$(resource.data.userId)).data.partnerId == request.auth.uid)
          )
        );
        allow create, update: if isAuthenticated() && 
          docId.matches('^' + request.auth.uid + '_.*') &&
          (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid) &&
          (!('steps' in request.resource.data) || (request.resource.data.steps >= 0 && request.resource.data.steps < 250000));
        allow delete: if isAuthenticated() && docId.matches('^' + request.auth.uid + '_.*');
      }

      // 3.2 Challenges: couples/{coupleId}/challenges/{id}
      match /challenges/{challengeId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId) && 
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.coupleId == coupleId;
        allow update: if isCoupleMember(coupleId) &&
          request.resource.data.coupleId == coupleId;
        allow delete: if isCoupleMember(coupleId) && resource.data.createdBy == request.auth.uid;
      }

      // 3.3 Milestones: couples/{coupleId}/milestones/{id}
      match /milestones/{milestoneId} {
        allow read: if isCoupleMember(coupleId);
        allow write: if isCoupleMember(coupleId);
      }

      // 3.4 Nudges: couples/{coupleId}/nudges/{id}
      match /nudges/{nudgeId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId) && 
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.recipientUid != request.auth.uid;
        allow update, delete: if isCoupleMember(coupleId) && resource.data.senderUid == request.auth.uid;
      }
    }
  }
}
