rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getCouple(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId));
    }

    function isCoupleMember(coupleId) {
      return isAuthenticated() && 
        (request.auth.uid in getCouple(coupleId).data.members);
    }

    // 1. User Profiles
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['partnerId']);
      allow delete: if isOwner(uid);
    }

    // 2. Invites (Server/Cloud Functions only)
    match /invites/{code} {
      allow read, write: if false;
    }

    // 3. Couples
    match /couples/{coupleId} {
      allow read: if isCoupleMember(coupleId);
      allow write: if false;

      // 3.1 Daily Aggregates: couples/{coupleId}/daily/{uid_date}
      match /daily/{docId} {
        allow read: if isCoupleMember(coupleId);
        allow create, update: if isCoupleMember(coupleId) && 
          docId.matches('^' + request.auth.uid + '_.*') &&
          (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid);
        allow delete: if isCoupleMember(coupleId) && docId.matches('^' + request.auth.uid + '_.*');
      }

      // 3.2 Challenges: couples/{coupleId}/challenges/{id}
      match /challenges/{challengeId} {
        allow read: if isCoupleMember(coupleId);
        allow write: if false;
      }

      // 3.3 Milestones: couples/{coupleId}/milestones/{id}
      match /milestones/{milestoneId} {
        allow read: if isCoupleMember(coupleId);
        allow write: if false;
      }

      // 3.4 Nudges: couples/{coupleId}/nudges/{id}
      match /nudges/{nudgeId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId) && 
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.recipientUid != request.auth.uid;
        allow update, delete: if isCoupleMember(coupleId) && resource.data.senderUid == request.auth.uid;
      }
    }
  }
}
